NOTION_TOKEN=
GEMINI_API_KEY=
# Optional: Claude API key (Sonnet for interview summaries, Haiku for other summaries and speaker names; Gemini otherwise)
ANTHROPIC_API_KEY=
# Hugging Face token (accept the terms of pyannote/speaker-diarization-community-1); optional, enables speaker labels
HF_TOKEN=
# Hardware for pyannote: cpu (default, lower memory) or mps (Apple GPU, faster but more memory)
DIARISATION_DEVICE=
# ID or link of the Notion database or page that receives the debriefs
NOTION_TARGET=
# First name of the person being interviewed (helps Gemini tell who is who in the transcript)
CANDIDATE_NAME=
# Working folder containing 01_A_Traiter/ and 02_Archives/ (default: ~/assistant-calls)
CALLS_FOLDER=
# Optional: OVHcloud AI Endpoints key, for the summary fallback when Gemini fails (works without it, at 2 requests/min)
OVH_AI_ENDPOINTS_ACCESS_TOKEN=
